# Ethereum Sepolia JSON-RPC endpoint from your chosen provider.
# This project intentionally has no mainnet deployment configuration.
SEPOLIA_RPC_URL=https://sepolia.example.invalid/YOUR_PROJECT_ID

# Private key for a dedicated, testnet-only Sepolia deployment account.
# Never use a primary wallet key. Never commit a real key. Keep the 0x prefix.
SEPOLIA_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_DEPLOYER_PRIVATE_KEY

# Required public EVM address that will receive the complete SAMPLE1 supply.
# Use a self-custody wallet address. Do not use a custodial exchange deposit address.
INITIAL_RECIPIENT=0xREPLACE_WITH_SELF_CUSTODY_WALLET_ADDRESS

# Leave unset during preparation. Set only after the separate deployment approval.
DEPLOYMENT_CONFIRMATION=REPLACE_AFTER_FINAL_APPROVAL
