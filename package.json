{
  "name": "erc20-token-sample",
  "version": "1.0.0",
  "description": "Fixed-supply ERC20 pilot with controlled Ethereum Sepolia deployment",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint 'contracts/**/*.sol'",
    "scan:secrets": "node scripts/secret-scan.js",
    "preflight:sepolia": "hardhat run scripts/preflight.js --network sepolia",
    "clean": "hardhat clean",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.6",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "chai": "^4.5.0",
    "dotenv": "^16.0.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.3",
    "solhint": "^5.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
